%% 雪落回声 · 系统架构（2026-06-28）
%% 主入口 web_chat.py + user_observer.py；备用 api.py / chat_ui.py
%% 数据源：仓库提交 数据源.pack.zip，启动解压到 数据源/

flowchart TB
  %% ===================== 客户端 =====================
  subgraph Client["浏览器（用户侧）"]
    UI["Web UI\ntemplates/chat.html"]
    ChatJS["static/chat.js\nSSE 对话 · 共享历史 · 观测面板"]
    StarGL["static/star_map_gl.js\n探索星图 WebGL"]
    LS["localStorage\n· 对话树 / 匿名 ID\n· observation_session_id"]
    UI --> ChatJS
    UI --> StarGL
    ChatJS --> LS
  end

  %% ===================== 进程 A：主对话 =====================
  subgraph ProcA["进程 A · 主对话（web_chat.py · :8000）"]
    direction TB
    subgraph Routes["FastAPI 路由"]
      R0["GET / · HTML"]
      R1["POST /api/chat · SSE 流式"]
      R2["POST /api/route-check"]
      R3["GET/POST /api/shared_history\n内存共享历史"]
      R4["/auth/* · /api/auth/me"]
      R5["/api/observation/*\n轨迹 · 星图 · 触发 · 修正"]
      R6["WebSocket /ws\n流式 + 观测写入"]
    end
    Auth["auth/google_oauth.py\nGoogle OAuth 或匿名 ID\nX-Anonymous-User-Id / cookie"]
    EventW["observation/event_writer.py\n每轮对话 append 事件"]
    ObsRead["observation/state_store.py\n只读 state / 星图 API"]
    LLM["LLMRAGSystem\nllm_rag_system.py"]
    Routes --> Auth
    R1 --> LLM
    R2 --> LLM
    R1 --> EventW
    R5 --> ObsRead
  end

  Client --> Routes

  %% ===================== LLM 编排层 =====================
  subgraph Orchestration["LLM 编排（llm_rag_system.py）"]
    RouteLLM["统一路由\nneed_rag + question_type\nDeepSeek JSON"]
    Rewrite["查询改写\n英文/混合 → 中文关键词"]
    Variants["chapter_rag 多 query 变体\nsearch_multi 合并去重"]
    HintR["ContextHintRouter\nobservation retrieval_hints\n仅扩展检索 query"]
    Reason["ReasoningModule\n行为/推演类多跳检索"]
    QuoteV["quote_validator\n引文 + 事实句 grounding\n最多 2 次打回 · 失败剥离引号"]
    Gen["回答生成\nflash / reasoner 分模型"]
    RouteLLM --> Rewrite --> Variants
    Variants --> HintR
    RouteLLM --> Reason
    Gen --> QuoteV
  end

  LLM --> Orchestration

  %% ===================== RAG 核心 =====================
  subgraph RAG["RAG 核心（rag_system.py + rag_modules/*）"]
    Core["NovelRAGSystem\nbuild_index · search · search_multi"]
    Vec["ChromaDB 持久化\nchroma_db/\nmain · sequel"]
    BM25["BM25 + jieba\nbm25_*_cache.pkl"]
    Ret["9 路检索器\nGlobalSummary · Timeline · CharacterArc\nImagery · Meta · ChapterRAG\nChapterSummary · BehaviorAnalyzer"]
    LC["langchain_adapters.py\n可选 LangChain BaseRetriever 封装"]
    Struct["StructuredQueryEngine\nJSON 知识库字段精准抽取"]
    DynSum["DynamicSummaryGenerator\n复杂问题动态摘要（可选）"]
    Core --> Vec
    Core --> BM25
    LLM --> Ret
    LLM --> Core
    Ret --> Struct
    Ret --> DynSum
    Ret -.-> LC
  end

  %% ===================== 数据源 =====================
  subgraph Data["数据源与打包"]
    Zip["数据源.pack.zip（可提交）"]
    Dir["数据源/（运行时，不提交）\n雪落成诗/影化成殇 txt\n人物.json · 时间线 · 意象\n元文本 · 关键事件 · 章节映射"]
    Loader["data_source_loader.py\n无目录时自动解压 zip"]
    Zip --> Loader --> Dir
    Dir --> Core
    Dir --> Ret
  end

  %% ===================== 外部 API =====================
  subgraph External["外部 API"]
    DS["DeepSeek Chat API\n路由 · 改写 · 回答 · 观测抽取"]
    QF["百度千帆 Embedding API\nqwen3-embedding-8b"]
    BaiduLLM["百度大模型 API（可选）\n问题类型辅助判断"]
  end

  Orchestration --> DS
  Core --> QF
  RouteLLM -.-> BaiduLLM

  %% ===================== 进程 B：用户观测 =====================
  subgraph ProcB["进程 B · 用户观测（user_observer.py）"]
    Poll["轮询调度\npoll_interval · N 轮阈值"]
    Worker["UserObserverWorker\nobserver.py"]
    Extract["StateExtractor\nextractor.py · LLM 增量抽取"]
    Sanitize["sanitize · schema 校验\n禁止人格化标签"]
    StarRender["star_map_render · nebula_starmap\n预计算星图进度/亮区"]
    Poll --> Worker --> Extract --> Sanitize --> StarRender
  end

  subgraph ObsStore["runtime_data/（本地，不提交 Git）"]
    SQLite[("observation.db\nSQLite WAL\nusers · chat_sessions\nconversation_events\nobservation_states")]
    ObsCfg["config/observer_config.yaml"]
  end

  EventW -->|"append-only 每轮事件"| SQLite
  ProcA -->|"达 N 轮后台线程\n或 POST trigger"| Worker
  Poll --> Worker
  SQLite --> Worker
  StarRender --> SQLite
  ObsCfg --> Worker
  Extract --> DS
  ObsRead --> SQLite
  HintR --> SQLite

  %% ===================== 星图消费 =====================
  subgraph StarMap["探索星图"]
    Catalog["static/data/exploration_star_catalog.json"]
    Bg["static/images/exploration_nebula_bg.webp"]
    APIStar["GET /api/observation/catalog\nGET .../starmap"]
    APIStar --> StarGL
    Catalog --> APIStar
    Bg --> StarGL
    StarRender --> APIStar
  end

  Client --> APIStar

  %% ===================== 备用入口 =====================
  subgraph Alt["备用入口"]
    Streamlit["chat_ui.py · Streamlit\n无观测/星图"]
  end

  %% ===================== 设计约束 =====================
  subgraph Constraints["防幻觉 / 设计约束"]
    C1["引文：quote_validator 校验引号内文字"]
    C2["无 RAG 时：提示「不知道」；路由失败默认 need_rag=true"]
    C3["观测 state 不注入回答标签\n仅 retrieval_hints 扩展检索"]
    C4["元文本/行为类：Reasoner 模型 + 结构化上下文"]
  end

  QuoteV -.-> C1
  RouteLLM -.-> C2
  HintR -.-> C3
