# 复制为 .env 或 SUPER_MIND_API_KEY.env 后填写真实值，切勿提交到 Git
# 部署时通过平台的环境变量/密钥注入，不要写在代码或仓库里

# LLM API（必填其一）
DEEPSEEK_API_KEY=sk-xxx
# OPENAI_API_KEY=sk-xxx
# OPENAI_API_BASE=https://api.openai.com/v1

# 向量 Embedding（仅千帆 API，必填）
BAIDU_API_KEY=your_baidu_qianfan_key
# EMBEDDING_MODEL_BAIDU=qwen3-embedding-8b

# 可选：部署时数据源与索引路径（不填则使用项目内 数据源、chroma_db）
# DATA_SOURCE_DIR=数据源
# CHROMA_DB_PATH=./chroma_db

# 可选：前端跨域（例如 GitHub Pages 前端域名）
# CORS_ORIGINS=https://username.github.io

# ---------- 用户观测模块 ----------
# 运行时 SQLite 目录（默认 ./runtime_data，已在 .gitignore）
# RUNTIME_DATA_DIR=runtime_data
# OBSERVER_CONFIG_PATH=config/observer_config.yaml
# OBSERVER_TRIGGER_N=10
# OBSERVER_POLL_SECONDS=15
# OBSERVER_EXTRACTOR_MODEL=deepseek-v4-flash

# ---------- Google OAuth（可选；不配置则使用匿名 ID）----------
# 公网部署：填后端根 URL（与 Google Console 授权回调域名一致）
# APP_PUBLIC_URL=https://your-backend.example.com
# GOOGLE_REDIRECT_URI 可省略，默认 ${APP_PUBLIC_URL}/auth/callback
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxx
# GOOGLE_REDIRECT_URI=https://your-backend.example.com/auth/callback
# AUTH_SECRET=随机长字符串（会话 cookie 签名；生产环境必填）
# AUTH_COOKIE_SECURE=true
