# 复制为 .env 或 SUPER_MIND_API_KEY.env 后填写真实值，切勿提交到 Git
# 部署时通过平台的环境变量/密钥注入，不要写在代码或仓库里

# ---------- LLM（必填其一）----------
DEEPSEEK_API_KEY=sk-xxx
# OPENAI_API_KEY=sk-xxx
# OPENAI_API_BASE=https://api.openai.com/v1
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_REASONER_MODEL=deepseek-v4-pro
# DEEPSEEK_ANSWER_MAX_TOKENS=4096

# ---------- 向量 Embedding（千帆，必填）----------
BAIDU_API_KEY=your_baidu_qianfan_key
# EMBEDDING_MODEL_BAIDU=qwen3-embedding-8b

# ---------- 路径（可选；不填则用项目内默认）----------
# DATA_SOURCE_DIR=数据源
# CHROMA_DB_PATH=./chroma_db
# RUNTIME_DATA_DIR=runtime_data
# OBSERVER_CONFIG_PATH=config/observer_config.yaml

# ---------- 跨域（可选；GitHub Pages 等前端）----------
# CORS_ORIGINS=https://username.github.io

# ---------- 用户观测（可选）----------
# OBSERVER_TRIGGER_N=10
# OBSERVER_POLL_SECONDS=15
# OBSERVER_EXTRACTOR_MODEL=deepseek-v4-flash
# OBSERVER_DEV_MODE=false

# ---------- 行为开关（可选）----------
# ENABLE_QUOTE_VALIDATION=true
# ENABLE_DYNAMIC_SUMMARY=true
# REASONING_TIMEOUT=120

# ---------- 会话安全（公网强烈建议）----------
# AUTH_SECRET=换成足够长的随机字符串
# AUTH_COOKIE_SECURE=true

# ---------- Google OAuth（可选；不配则匿名 ID）----------
# 双公网并存（同年下半年）：同一 Google 客户端可同时挂两个回调 URI
#   1) AI Builders: https://snow-falls-q-a.ai-builders.space/auth/callback
#   2) Koyeb:       https://<你的-app>.koyeb.app/auth/callback
# 每个部署平台各自注入「本平台」的 APP_PUBLIC_URL / GOOGLE_REDIRECT_URI，不要混用。
#
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxx
#
# --- AI Builders 部署示例 ---
# APP_PUBLIC_URL=https://snow-falls-q-a.ai-builders.space
# GOOGLE_REDIRECT_URI=https://snow-falls-q-a.ai-builders.space/auth/callback
#
# --- Koyeb（新账号目前多需付费；仅作占位）---
# APP_PUBLIC_URL=https://<你的-app>.koyeb.app
# GOOGLE_REDIRECT_URI=https://<你的-app>.koyeb.app/auth/callback
#
# --- Hugging Face Spaces（Docker）示例 ---
# 公网根 URL 一般是：https://<user>-<space>.hf.space
# APP_PUBLIC_URL=https://<user>-snow-falls-q-a.hf.space
# GOOGLE_REDIRECT_URI=https://<user>-snow-falls-q-a.hf.space/auth/callback
#
# --- Google Cloud Run 示例（第二条腿）---
# APP_PUBLIC_URL=https://<service>-<hash>-<region>.a.run.app
# GOOGLE_REDIRECT_URI=https://<service>-<hash>-<region>.a.run.app/auth/callback
#
# GOOGLE_REDIRECT_URI 可省略：省略时默认 ${APP_PUBLIC_URL}/auth/callback

# ---------- 仅本地触发 AI Builders 部署脚本用（勿提交真实值；Koyeb 直连不需要）----------
# AI_BUILDER_TOKEN=
# SUPER_MIND_API_KEY=

# ---------- 平台注入（一般不用手写）----------
# PORT=8000
